  m_Name: Profile_Scout
  m_EditorClassIdentifier: Assembly-CSharp::AbyssBar.Characters.CharacterProfileData
  characterName: "\u671D\u9727 \u51DC"
  roleTitle: "\u5075\u5BDF\u54E1"
  combatRole: "\u6A5F\u52D5\u9060\u7A0B\u30FB\u6383\u7DDA\u5C04\u624B"
  summary: "\u8CA0\u8CAC\u66FF\u9152\u5427\u5C0B\u627E\u91CD\u8FD4\u5730\u9762\u7684\u8DEF\u3002\u5979\u7E3D\u662F\u7B2C\u4E00\u500B\u63A2\u51FA\u63A9\u9AD4\uFF0C\u4E5F\u7E3D\u8A18\u5F97\u66FF\u968A\u53CB\u7559\u4E0B\u64A4\u96E2\u7684\u7A7A\u9593\u3002\u6BD4\u8D77\u7AD9\u8457\u786C\u62DA\uFF0C\u5979\u66F4\u76F8\u4FE1\u4E00\u689D\u4E7E\u6DE8\u7684\u5C04\u7DDA\u3002\n\n\u723D\u6717\u3001\u53CD\u61C9\u5FEB\uFF0C\u7B49\u4EBA\u6642\u7E3D\u611B\u628A\u73A9\u624B\u4E0A\u7684\u624B\u69CD\u3002\u5634\u4E0A\u8AAA\u8457\u53EA\u662F\u9806\u8DEF\uFF0C\u56DE\u7A0B\u6642\u537B\u5E38\u5E36\u8457\u5225\u4EBA\u8A17\u4ED8\u7684\u5C0F\u6771\u897F\u3002"
  specialties:
  - "\u9748\u6D3B\u8D70\u4F4D"
  - "\u6247\u5F62\u6383\u7DDA"
  - "\u7A7F\u900F\u6210\u9577"
  - "\u74B0\u72C0\u7206\u88C2"
  strength: "\u79FB\u52D5\u5FEB\u3001\u5BB9\u6613\u8ABF\u6574\u5C04\u7DDA\uFF1B\u5F37\u5316 E \u53EF\u6CBF\u6575\u7FA4\u7A7F\u900F\uFF0C\u5F37\u5316 Q \u7684\u7206\u88C2\u9069\u5408\u5BC6\u96C6\u76EE\u6A19\u3002"
  caution: "\u751F\u547D\u8F03\u4F4E\uFF0C\u4FDD\u7559\u9583\u907F\u8207\u64A4\u9000\u8DEF\u7DDA\u3002\u5979\u7684\u5927\u62DB\u662F\u74B0\u72C0\u5F48\u5E55\uFF0C\u4E26\u4E0D\u63D0\u4F9B\u7121\u6575\u3002"
  baseEHint: "\u81EA\u52D5\u671D\u7BC4\u570D\u5167\u6700\u8FD1\u7684\u6575\u4EBA\u767C\u5C04 5 \u679A\u5B50\u5F48\uFF0C\u6563\u5E03\u89D2\u5EA6 60\xB0\u3002\u6C92\u6709\u6709\u6548\u76EE\u6A19\u6642\u4E0D\u6D88\u8017\u5145\u80FD\uFF1B\u6ED1\u9F20\u7784\u6E96\u76EE\u524D\u9069\u7528\u65BC\u666E\u901A\u653B\u64CA\u3002"
  enhancedEHint: "\u4FDD\u7559\u6700\u8FD1\u76EE\u6A19\u9396\u5B9A\u8207 5 \u767C\u6247\u5F62\u5C04\u64CA\uFF1B\u6BCF\u679A\u5B50\u5F48\u6700\u591A\u547D\u4E2D 3 \u540D\u6575\u4EBA\u3002\u5229\u7528\u8D70\u4F4D\u8B93\u6575\u7FA4\u6392\u5217\u5728\u5C04\u7DDA\u4E0A\u80FD\u63D0\u9AD8\u6536\u76CA\u3002"
  baseQHint: "\u5411\u56DB\u5468\u540C\u6642\u767C\u5C04 16 \u679A\u5B50\u5F48\uFF0C\u6E05\u7406\u5468\u570D\u7684\u6575\u7FA4\u3002"
  enhancedQHint: "\u74B0\u72C0\u5F48\u5E55\u547D\u4E2D\u6575\u4EBA\u5F8C\u7206\u88C2\uFF0C\u64F4\u5927\u5C0D\u5BC6\u96C6\u76EE\u6A19\u7684\u50B7\u5BB3\uFF1B\u7206\u88C2\u7684\u6B63\u5F0F\u6578\u503C\u6CBF\u7528\u73FE\u6709\u6230\u9B25\u908F\u8F2F\u3002"
