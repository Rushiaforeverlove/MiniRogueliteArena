  m_Name: Profile_Guard
  m_EditorClassIdentifier: Assembly-CSharp::AbyssBar.Characters.CharacterProfileData
  characterName: "\u5FA1\u5F71 \u5343\u6B72"
  roleTitle: "\u9632\u885B\u968A\u54E1"
  combatRole: "\u8FD1\u8EAB\u7BC4\u570D\u30FB\u9707\u7206\u9632\u885B"
  summary: "\u5979\u5B88\u4F4F\u7684\u4E0D\u53EA\u662F\u4E00\u6247\u9580\uFF0C\u4E5F\u662F\u9152\u5427\u88E1\u6BCF\u500B\u4EBA\u56DE\u5BB6\u7684\u8DEF\u3002\u91CD\u578B\u624B\u69CD\u8CA0\u8CAC\u958B\u8DEF\uFF0C\u76FE\u4E0A\u7684\u9707\u7206\u88DD\u7F6E\u5247\u66FF\u88AB\u5305\u570D\u7684\u968A\u53CB\u6495\u958B\u7A7A\u9593\u3002\n\n\u6C89\u7A69\u3001\u6703\u7167\u9867\u4EBA\uFF0C\u56DE\u5230\u5427\u6AAF\u5F8C\u537B\u80FD\u8C6A\u723D\u5730\u559D\u4E0B\u4E00\u5927\u53E3\u7425\u73C0\u62C9\u683C\u3002\u5979\u6703\u7B11\u8457\u8AAA\u81EA\u5DF1\u53EA\u662F\u5750\u4E00\u6703\u5152\uFF0C\u4F4D\u7F6E\u537B\u7E3D\u7559\u5728\u5927\u5BB6\u770B\u5F97\u898B\u7684\u5730\u65B9\u3002"
  specialties:
  - "\u9AD8\u751F\u547D"
  - "\u91CD\u578B\u5C04\u64CA"
  - "\u5468\u8EAB\u9707\u7206"
  - "\u4E09\u91CD\u7206\u767C"
  strength: "\u751F\u547D\u8F03\u9AD8\uFF0C\u91CD\u578B\u5C04\u64CA\u6709\u5206\u91CF\uFF1BE \u8207 Q \u76F4\u63A5\u8655\u7406\u8FD1\u8EAB\u6575\u7FA4\uFF0C\u5F37\u5316 Q \u53EF\u5728 1 \u79D2\u5167\u5B8C\u6210\u4E09\u6B21\u9707\u7206\u3002"
  caution: "\u79FB\u52D5\u8F03\u6162\uFF0C\u9700\u63D0\u65E9\u907F\u958B\u9810\u8B66\uFF1B\u9707\u7206\u7684\u7BC4\u570D\u5F88\u5927\uFF0C\u4F46\u4ECD\u8981\u4FDD\u7559\u9583\u907F\u8207\u5B89\u5168\u7684\u9000\u8DEF\u3002"
  baseEHint: "\u4EE5\u81EA\u8EAB\u70BA\u4E2D\u5FC3\u9707\u7206\uFF0C\u7BC4\u570D\u534A\u5F91 3\uFF0C\u9020\u6210 400 \u57FA\u790E\u50B7\u5BB3\u3002"
  enhancedEHint: "\u4EE5\u81EA\u8EAB\u70BA\u4E2D\u5FC3\u9707\u7206\uFF0C\u534A\u5F91\u63D0\u5347\u70BA 4\u3001\u57FA\u790E\u50B7\u5BB3\u63D0\u5347\u70BA 600\u3002"
  baseQHint: "\u4EE5\u81EA\u8EAB\u70BA\u4E2D\u5FC3\u767C\u52D5\u534A\u5F91 5 \u7684\u6DF1\u5C64\u9707\u7206\uFF0C\u9020\u6210 1,000 \u57FA\u790E\u50B7\u5BB3\u3002"
  enhancedQHint: "\u9023\u7E8C\u9707\u7206 3 \u6B21\uFF0C\u6BCF\u6B21\u57FA\u790E\u50B7\u5BB3 500\uFF0C\u9593\u9694 0.5 \u79D2\u3002\u4E09\u6B21\u547D\u4E2D\u5408\u8A08 1,500\uFF1B\u662F\u5426\u547D\u4E2D\u4ECD\u4F9D\u6BCF\u6B21\u6575\u4EBA\u4F4D\u7F6E\u5224\u5B9A\u3002"
