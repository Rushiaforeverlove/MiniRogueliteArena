  m_Name: MioProfile
  m_EditorClassIdentifier: Assembly-CSharp::AbyssBar.Characters.CharacterProfileData
  characterName: "\u5982\u6708 \u6FAA"
  roleTitle: "\u7834\u9663\u968A\u54E1"
  combatRole: "\u8FD1\u8EAB\u7834\u9663\uFF0F\u84C4\u529B\u528D\u6C23\uFF0F\u89E3\u653E\u7206\u767C"
  summary: "\u53EA\u8981\u5427\u6AAF\u9084\u6709\u7A7A\u4F4D\uFF0C\u6FAA\u5C31\u80FD\u7761\u8457\u3002\u90A3\u628A\u6BD4\u5979\u9084\u986F\u773C\u7684\u5927\u528D\uFF0C\u53EA\u6709\u5728\u540C\u4F34\u9700\u8981\u4E00\u689D\u9000\u8DEF\u6642\u624D\u6703\u51FA\u9798\u3002"
  specialties:
  - "\u9EDE\u6309\u8FD1\u65AC"
  - "\u9577\u6309\u84C4\u529B"
  - "\u96D9\u5145\u80FD\u4F4D\u79FB"
  - "\u7D05\u77B3\u89E3\u653E"
  strength: "\u7528 E \u7A7F\u904E\u5305\u570D\u5F8C\u65CB\u65AC\uFF0C\u518D\u4EE5\u84C4\u529B\u528D\u6C23\u6574\u7406\u6575\u9663\uFF1BQ \u7684\u516D\u79D2\u7206\u767C\u80FD\u540C\u6642\u7167\u9867\u8FD1\u8EAB\u8207\u5468\u570D\u6575\u4EBA\u3002"
  caution: "\u9EDE\u6309\u5728\u653E\u958B\u6ED1\u9F20\u6642\u51FA\u5200\u3002\u84C4\u529B\u672A\u6EFF\u6703\u8FD1\u65AC\uFF1BE \u8207 Shift \u53EF\u4EE5\u7A7F\u904E\u6575\u4EBA\uFF0C\u4F46\u7246\u58C1\u4ECD\u6703\u963B\u64CB\u3002"
  baseEHint: "\u96D9\u5145\u80FD\u3001\u9010\u6B21\u56DE\u5FA9\u3002\u671D\u6ED1\u9F20\u65B9\u5411\u4F4D\u79FB\u5F8C\u5927\u7BC4\u570D\u65CB\u65AC\u4E26\u5927\u5E45\u64CA\u9000\uFF0C\u4F4D\u79FB\u8207\u65CB\u65AC\u5168\u7A0B\u7121\u6575\uFF0C\u7246\u58C1\u4ECD\u6703\u963B\u64CB\u3002"
  enhancedEHint: "\u96D9\u5145\u80FD\u3001\u9010\u6B21\u56DE\u5FA9\u3002\u671D\u6ED1\u9F20\u65B9\u5411\u4F4D\u79FB\u5F8C\u5927\u7BC4\u570D\u65CB\u65AC\u4E26\u5927\u5E45\u64CA\u9000\uFF0C\u4F4D\u79FB\u8207\u65CB\u65AC\u5168\u7A0B\u7121\u6575\uFF0C\u7246\u58C1\u4ECD\u6703\u963B\u64CB\u3002\u4E26\u5728\u7D93\u904E\u8DEF\u5F91\u7559\u4E0B\u5EF6\u9072\u65AC\u64CA\u3002"
  baseQHint: "\u89E3\u653E\u7D05\u77B3\u516D\u79D2\u3002\u8B8A\u8EAB\u6642\u53EA\u64CA\u9000\u3001\u4E0D\u9020\u6210\u50B7\u5BB3\uFF1B\u9EDE\u6309\u8FFD\u52A0\u528D\u6C23\uFF0C\u84C4\u529B\u91CB\u653E\u516D\u5411\u528D\u6C23\uFF0CE \u4F4D\u79FB\u8207\u65CB\u65AC\u7BC4\u570D\u63D0\u5347\u4E26\u64CA\u9000\u3002"
  enhancedQHint: "\u4FDD\u7559\u89E3\u653E\u6548\u679C\uFF1B\u671F\u9593\u6210\u529F\u547D\u4E2D\u7684\u653B\u64CA\u6700\u591A\u8A18\u9304\u516D\u6B21\uFF0C\u89E3\u653E\u7D50\u675F\u5F8C\u4F9D\u5E8F\u653E\u51FA\u6B98\u97FF\u528D\u6C23\u3002"
